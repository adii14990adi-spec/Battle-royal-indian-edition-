# Normalize line endings
* text=auto eol=lf

# Godot text files
*.gd    text eol=lf
*.tscn  text eol=lf
*.tres  text eol=lf
*.cfg   text eol=lf
*.godot text eol=lf
*.import text eol=lf

# Binary files — never diff as text
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.exr   binary
*.hdr   binary
*.glb   binary
*.gltf  text eol=lf
*.ogg   binary
*.wav   binary
*.mp3   binary
*.ttf   binary
*.otf   binary
*.res   binary
*.scn   binary

# Git LFS-tracked types
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.glb   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
