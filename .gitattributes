# Normalize text line endings
* text=auto eol=lf

# Git LFS-tracked types - binary assets.
# Files matching these patterns are committed as LFS pointers; the real bytes
# live on the Git LFS server. They can NEVER be uploaded through the GitHub
# web editor (the browser would commit the pointer text itself and corrupt
# the asset) - always add them from a clone with `git lfs` installed.
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.webp  filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.mtl   filter=lfs diff=lfs merge=lfs -text
*.bin   filter=lfs diff=lfs merge=lfs -text

# Unity animation clips and animator controllers are text assets: store them
# as plain Git text with LF line endings so diffs and merges work normally.
# (They previously carried `diff=lfs merge=lfs`, which without a real LFS
# merge driver makes every conflicted .anim/.controller unmergeable.)
*.anim       text eol=lf
*.controller text eol=lf

# 3D model sources are deliberately NOT LFS-tracked: .glb/.gltf and .fbx are
# ordinary Git blobs, so small files can be added through the GitHub web
# editor directly. Keep individual models reasonably sized; Git handles them
# fine as blobs up to a few tens of MB.
