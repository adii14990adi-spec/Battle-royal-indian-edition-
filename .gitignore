# Unity generates these locally; the project source is Assets/, Packages/ and ProjectSettings/.
unity-project/[Ll]ibrary/
unity-project/[Tt]emp/
unity-project/[Oo]bj/
unity-project/[Bb]uild/
unity-project/[Bb]uilds/
unity-project/[Ll]ogs/
unity-project/[Uu]ser[Ss]ettings/
unity-project/[Mm]emoryCaptures/
unity-project/[Rr]ecordings/
unity-project/[Cc]rashlytics/
unity-project/Assets/AssetStoreTools*
unity-project/*.csproj
unity-project/*.sln
unity-project/*.unityproj
unity-project/*.suo
unity-project/*.user
unity-project/*.userprefs
unity-project/.vs/
unity-project/.vsconfig
unity-project/.idea/
unity-project/.gradle/
unity-project/**/*.apk
unity-project/**/*.aab
unity-project/**/*.keystore
unity-project/**/*.jks
unity-project/ProjectSettings/UnityConnectSettings.asset

# Local build products and signing material — never commit.
build/
*.apk
*.aab
*.keystore
*.jks
*.ulf
*.alf
*.p12

# Editor / operating system files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
*.log

# Blender pipeline output (reproducible from processing/blender/generators/).
processing/blender/output/
processing/blender/.blender-cache/

# Python tooling
__pycache__/
*.pyc
.pytest_cache/

# Generated character/animation authoring assets (created by the Character &
# Animation Manager, the headless integration builder and EditMode tests).
# FBX and .fbx.meta source files ARE committed; these generated outputs are
# reproducible from the committed sources, so they are never committed.
unity-project/Assets/Generated/*
!unity-project/Assets/Generated/.gitkeep
unity-project/Assets/AnimationControllers/*
!unity-project/Assets/AnimationControllers/.gitkeep
unity-project/Assets/AvatarMasks/*
!unity-project/Assets/AvatarMasks/.gitkeep

# Local Python virtualenv used to run the static validators.
.venv/
