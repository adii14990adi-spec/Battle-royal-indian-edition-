unity-project/[Rr]ecordings/
unity-project/[Cc]rashlytics/
unity-project/Assets/AssetStoreTools*
unity-project/*.csproj
unity-project/*.sln
unity-project/*.unityproj
unity-project/*.suo
unity-project/*.user
unity-project/*.userprefs
