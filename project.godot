; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters
;
; Battle Horizons: Last Survival — Phase 1 baseline. Every value below is
; chosen for a Unisoc T606 / 4 GB RAM Android device (GLES3 Compat renderer,
; 30 FPS floor).
; See docs/UNISOC_BUDGET.md before raising any of these numbers.

config_version=5

[application]

config/name="Battle Horizons: Last Survival"
config/version="0.0.1-setup"
run/main_scene="res://scenes/core/boot.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
; Phase 3: the default Godot logo covered the boot screen and looked like a
; hang on a slow device. No splash image; the sky colour is shown instead so
; the first frame is not a black flash either.
boot_splash/show_image=false
boot_splash/bg_color=Color(0.63, 0.73, 0.84, 1)
run/max_fps=30

[autoload]

PerfManager="*res://scripts/autoload/perf_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
textures/default_filters/anisotropic_filtering_level=0
textures/default_filters/texture_mipmap_bias=0.75
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=512
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/atlas_size=512
limits/opengl/max_lights_per_object=2
limits/opengl/max_renderable_elements=100000
occlusion_culling/use_occlusion_culling=false
environment/defaults/default_clear_color=Color(0.63, 0.73, 0.84, 1)
