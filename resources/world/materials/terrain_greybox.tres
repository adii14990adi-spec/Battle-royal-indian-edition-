; Greybox terrain material — one material for all 64 baked chunks.
;
; Unshaded, vertex-coloured, no textures: see assets/shaders/terrain_greybox.gdshader.
; Every parameter here is a baked-in constant on purpose; there is no per-frame
; cost and no PBR. Budget reference: docs/UNISOC_BUDGET.md.

[gd_resource type="ShaderMaterial" load_steps=2 format=3]

[ext_resource type="Shader" path="res://assets/shaders/terrain_greybox.gdshader" id="1_terrain"]

[resource]
shader = ExtResource("1_terrain")
shader_parameter/sun_direction = Vector3(0.45, 0.78, 0.44)
shader_parameter/sun_strength = 0.85
shader_parameter/ambient_strength = 0.42
shader_parameter/grain_scale = 0.035
shader_parameter/grain_strength = 0.1
shader_parameter/fog_color = Vector3(0.66, 0.72, 0.78)
shader_parameter/fog_start = 420.0
shader_parameter/fog_density = 0.00085
