[gd_scene load_steps=5 format=3]

; "Hello Unisoc" baseline scene (Phase 1 §8).
; One Node3D root, one Camera3D at (0, 1, 3) aimed at the origin, one textured
; unshaded box, one shadow-less DirectionalLight3D, and a Control/Label that
; prints device model + GPU + GLES3 status from the PerfManager autoload.

[ext_resource type="Texture2D" path="res://assets/textures/test_pattern_256.png" id="1_tex"]
[ext_resource type="Script" path="res://scripts/ui/boot_screen.gd" id="2_boot"]

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_unshaded"]
shading_mode = 0
albedo_texture = ExtResource("1_tex")
texture_filter = 3

[sub_resource type="BoxMesh" id="BoxMesh_test"]
size = Vector3(1.2, 1.2, 1.2)

[node name="Boot" type="Node3D"]
script = ExtResource("2_boot")

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.948683, -0.316228, 0, 0.316228, 0.948683, 0, 1, 3)
current = true
fov = 55.0

[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866025, 0, 0.5, 0.383022, 0.642788, -0.663414, -0.321394, 0.766044, 0.55667, 2, 4, 2)
shadow_enabled = false

[node name="TestBox" type="MeshInstance3D" parent="."]
mesh = SubResource("BoxMesh_test")
material_override = SubResource("StandardMaterial3D_unshaded")

[node name="UI" type="CanvasLayer" parent="."]

[node name="Root" type="Control" parent="UI"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="InfoLabel" type="Label" parent="UI/Root"]
layout_mode = 1
offset_left = 28.0
offset_top = 22.0
offset_right = 1252.0
offset_bottom = 140.0
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0.03, 0.03, 0.05, 1)
theme_override_constants/outline_size = 6
theme_override_constants/line_spacing = 8
theme_override_font_sizes/font_size = 22
text = "DESI ROYALE — Phase 1 boot baseline\nDevice: ... | GPU: ... | GLES3 ...\nFPS: ... | static: ... | video: ... | draws: ..."
