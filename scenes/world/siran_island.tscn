[gd_scene load_steps=11 format=3]

; Siran Island — Phase 3 greybox world. Run with:
;     godot --path . scenes/world/siran_island.tscn
;
; What is deliberately NOT here: buildings, houses, monuments, props, trees.
; Phase 3 is terrain + water + roads + zone markers only, so that streaming and
; frame time can be measured without geometry in the way.
;
; The terrain itself is *not* in this scene: ChunkManager loads the committed
; baked map (scenes/world/siran_island_baked.tscn, generated once by
; TerrainGenerator) and streams its 64 chunk children in and out. The river
; ribbon is a separate generated resource loaded by `RiverSurface`, because a
; missing [ext_resource] would stop this scene from opening at all.

[ext_resource type="Shader" path="res://assets/shaders/water_surface.gdshader" id="1_water_shader"]
[ext_resource type="Texture2D" path="res://assets/textures/water_normal_256.png" id="2_water_normal"]
[ext_resource type="Script" path="res://scripts/world/baked_extras.gd" id="3_extras"]
[ext_resource type="Script" path="res://scripts/world/chunk_manager.gd" id="4_chunks"]
[ext_resource type="Script" path="res://scripts/world/debug_spectator.gd" id="5_spectator"]
[ext_resource type="Script" path="res://scripts/ui/world_debug_hud.gd" id="6_hud"]

